<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    tools:context="com.example.my.MainActivity">

    <TextView
        android:id="@+id/ac1_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="头部标签"
        style="@style/myText"
         />

    <FrameLayout
        android:id="@+id/ac1_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ac1_bar"
        android:layout_below="@+id/ac1_top"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp">

    </FrameLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/ac1_bar"
        android:name="com.example.my.myPage.myToolBar.ToolBarFrag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        tools:layout="@layout/fragment_tool_bar" />

</RelativeLayout>